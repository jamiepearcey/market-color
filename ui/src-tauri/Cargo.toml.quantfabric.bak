[package]
name = "quant-fabric-app"
version = "0.1.0"
description = "Tauri desktop shell for quant-fabric"
edition = "2021"
rust-version = "1.77.2"
# The GUI is the default `cargo run` target; `qf-scheduler` is the headless daemon.
default-run = "quant-fabric-app"

[workspace]

[lib]
name = "quant_fabric_app_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2.6.1", features = [] }

[dependencies]
anyhow = "1"
axum = "0.7"
chrono = { version = "0.4.45", default-features = false, features = ["clock"] }
croner = "3.0.1"
# OS user keychain (macOS Keychain / Windows Credential Manager / Linux Secret
# Service) for QuantFabric's own secret-zero: the secrets-keeper bearer token
# lives here instead of the plaintext pref store (option A).
keyring = { version = "3", features = ["apple-native", "windows-native", "sync-secret-service"] }
# Control-plane store (ADR-0021): embedded PGlite (Postgres-in-WASM) from Rust.
# Requires rustc >= 1.93 — pinned via rust-toolchain.toml.
pglite-oxide = "0.5"
quant-fabric = { path = "../../quant-fabric", features = ["celeritas-data-plane"] }
# Canonical list of registered DuckDB quant scalar functions, surfaced to the
# pack editor's SQL completions via `list_quant_functions`. Mirrors quant-fabric's
# feature choice so cargo unifies the (already-built) duckdb-quant dependency.
duckdb-quant = { path = "../../duckdb-quant", default-features = false }
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
sqlx = { version = "0.8", default-features = false, features = ["runtime-tokio", "postgres", "json"] }
tauri = { version = "2.11.1", features = [] }
tauri-plugin-dialog = "2"
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
toml = "0.8"
zip = { version = "2", default-features = false, features = ["deflate"] }

[dev-dependencies]
tempfile = "3.27.0"

[profile.release]
strip = true
lto = "thin"
codegen-units = 1
panic = "abort"
