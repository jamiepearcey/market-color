{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@cubecanvas/grid-react": [
        "../../../../analytics/CubeCanvas/repo/grid/react/dist/grid/react/src/index.d.ts"
      ],
      "@cubecanvas/grid-core": [
        "../../../../analytics/CubeCanvas/repo/grid/react/dist/grid-core/src/index.d.ts"
      ],
      "@cubecanvas/grid-core-wasm": [
        "../../../../analytics/CubeCanvas/repo/grid/react/dist/adapters/grid-core-wasm/src/index.d.ts"
      ],
      "@cubecanvas/ui/lib/utils": [
        "../../../../analytics/CubeCanvas/repo/packages/ui/dist/lib/utils.d.ts"
      ],
      "@cubecanvas/ui": [
        "../../../../analytics/CubeCanvas/repo/grid/react/dist/packages/ui/src/index.d.ts"
      ]
    },
    "exactOptionalPropertyTypes": true
  },
  "include": ["src"]
}
