# dependencies / build output
node_modules/
dist/
**/target/
*.tsbuildinfo

# python caches
__pycache__/
*.pyc
.venv/

# local Qdrant storage — 500MB+, regenerate by running index_facts.py
qdrant_storage/
qdrant_snapshots/
.qdrant-initialized

# orchestrator-generated config + scratch
config/*.generated.json
data/tmp/

# large generated artifacts (regenerate via the pipeline scripts)
# ~240MB embeddings/transport matrices (.npy/.npz)
receptors/data/
# ~314MB BGE-base embeddings/transport matrices (.npy/.npz)
receptors/data_bge_base/
# archive backup of data/news_corpus/
data/news_corpus.zip
# generated eval run outputs
eval/*_out/
eval/blind_*/

# os / editor / logs
.DS_Store
*.log

# secrets
.env
.env.*

# eventgraph regenerable extraction artifacts (regenerate via extract.py; never commit corpora)
eventgraph/out/
eventgraph/data/

# eventgraph experiment data (2.1GB+: graphs, checkpoints, price caches, DuckLake) —
# synced to GCS (gs://nimble-sylph-96609-market-color-data), see data/eg_runs/README.md
data/eg_runs/
# stray DuckLake artifacts from running loaders at repo root (regenerable)
eventgraph_catalog.ducklake
eg_data/
