# dependencies / build output
node_modules/
dist/
**/target/
*.tsbuildinfo

# python caches
__pycache__/
*.pyc
.venv/

# local Qdrant storage — 500MB+, regenerate by running index_facts.py
qdrant_storage/
qdrant_snapshots/
.qdrant-initialized

# orchestrator-generated config + scratch
config/*.generated.json
data/tmp/

# large generated artifacts (regenerate via the pipeline scripts)
# ~240MB embeddings/transport matrices (.npy/.npz)
receptors/data/
# archive backup of data/news_corpus/
data/news_corpus.zip
# generated eval run outputs
eval/*_out/
eval/blind_*/

# os / editor / logs
.DS_Store
*.log

# secrets
.env
.env.*
